GEMINI_API_KEY=your_api_key_here
PORT=5000

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low        # low (fastest supported) | medium | high | off
# VITE_DEMO_MODE=true              # local fallback data if Gemini is unreachable (UI shows DEMO MODE)

# Deployment (leave unset for local dev)
# VITE_API_URL=https://your-service.onrender.com   # frontend build: where the backend lives
# CORS_ORIGIN=https://your-app.vercel.app           # backend: allowed frontend origin(s), comma-separated
